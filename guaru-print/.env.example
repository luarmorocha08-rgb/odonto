# ─────────────────────────────────────────────────────────────
# Guaru Print — variáveis de ambiente
# Copie para .env.local e preencha. Nada aqui é obrigatório para o site rodar:
# sem Supabase o site usa os dados demonstrativos de src/content.
# ─────────────────────────────────────────────────────────────

# URL pública final (sem barra no fim). Usada em SEO, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.guaruprint.com.br

# WhatsApp oficial no formato internacional, só dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=5513992095305

# Medição (opcional). Só é carregada após o consentimento do visitante.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Supabase (opcional) ──────────────────────────────────────
# Banco de dados do painel + armazenamento privado das artes enviadas.
# Rode supabase/schema.sql no SQL Editor antes de preencher.
NEXT_PUBLIC_SUPABASE_URL=
# Opcional: enviada no upload direto do navegador para a URL assinada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A chave service_role é usada SOMENTE no servidor (rotas de API e painel).
# Nunca use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=
# Validade (em dias) do link assinado da arte enviado no WhatsApp. Padrão: 7.
QUOTE_FILE_LINK_DAYS=7

# ── Painel administrativo (/admin) ───────────────────────────
# Senha de acesso ao painel (mínimo 12 caracteres). Sem ela o painel fica bloqueado.
ADMIN_PASSWORD=
# Segredo usado para assinar o cookie de sessão (32+ caracteres aleatórios).
# Gere com: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Opcional: assina os tickets de upload de arte (padrão: ADMIN_SESSION_SECRET).
QUOTE_SIGNING_SECRET=
