# ─────────────────────────────────────────────────────────────
# J.A Odontologia Estética — variáveis de ambiente
# Copie para .env.local e preencha SOMENTE com dados confirmados.
# Campos vazios fazem a informação correspondente ser ocultada no site.
# ─────────────────────────────────────────────────────────────

# URL pública definitiva (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# WhatsApp oficial — apenas dígitos, com DDI e DDD.
# Já configurado no código como (13) 99741-2905; preencha só para trocar.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_FALLBACK_URL=https://wa.me/message/KW6TKPHWGNFLC1

# Endereço e horários (deixe vazio para ocultar)
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_DISTRICT=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
NEXT_PUBLIC_OPENING_HOURS=
# Telefone fixo opcional, ex.: +55 13 3333-3333
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=

# Responsável técnica (obrigatório em publicidade odontológica)
NEXT_PUBLIC_RESPONSIBLE_NAME=
NEXT_PUBLIC_RESPONSIBLE_CRO=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_LEGAL_NAME=

# Analytics (carregados SOMENTE após consentimento do visitante)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Opcional: webhook que recebe o formulário de contato (Zapier, Make, n8n,
# CRM etc.). Se vazio, o formulário encaminha os dados para o WhatsApp.
CONTACT_WEBHOOK_URL=
